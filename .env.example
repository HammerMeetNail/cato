# Docker Compose reads this file only after copying it to .env.
# Cato is HTTPS-only (docs/production-runbook.md). Pick one:
#
# 1. HTTPS reverse proxy (Caddy, Synology, …) terminating TLS in front of Cato:
#    set the external https:// origin. Cookies become Secure and __Host- prefixed
#    and HSTS is sent. List the proxy's address so X-Forwarded-For/-Proto count.
CATO_BASE_URL=https://cato.example.com
CATO_TRUSTED_PROXIES=
#
# 2. Native TLS: certificate files maintained by an ACME client (paths inside
#    the container; Cato reloads renewed files without a restart).
CATO_TLS_CERT_FILE=
CATO_TLS_KEY_FILE=
#
# 3. LAN/testing only: CATO_DEV_TLS=1 generates a self-signed certificate.
CATO_DEV_TLS=
#
# Legacy plain-HTTP deployments must opt out explicitly (not recommended):
CATO_ALLOW_INSECURE=
#
# Sign-up: closed (default; only the first account), open, or invite.
CATO_SIGNUP=closed
#
# Register <CATO_BASE_URL>/api/auth/google/callback in Google OAuth settings.
GOOGLE_KEY=
GOOGLE_SECRET=
TWITCH_OAUTH_ID=
TWITCH_OAUTH_SECRET=
#
# Operations (all optional). A token required on /metrics (otherwise only
# private-network clients can read it); log format text|json; where the
# automatic pre-upgrade database snapshots go (default data/backups).
CATO_METRICS_TOKEN=
CATO_LOG_FORMAT=text
CATO_BACKUP_DIR=
#
# Integrations (all optional; each feature hides itself when unset).
# Wikidata links to HowLongToBeat/PCGamingWiki (sends game slugs to wikidata.org).
CATO_WIKIDATA_LINKS=
# Steam import and daily play time sync: https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=
# Wishlist price alerts: https://isthereanydeal.com/apps/my/
ITAD_API_KEY=
# Barcode lookups use UPCitemdb's free tier (100/day); a paid key lifts it.
UPCITEMDB_KEY=
# Web Push contact for the push services (mailto: or https:); defaults to CATO_BASE_URL.
CATO_PUSH_CONTACT=
# Weekly email digest (port 465 = TLS, otherwise STARTTLS).
CATO_SMTP_HOST=
CATO_SMTP_PORT=587
CATO_SMTP_USER=
CATO_SMTP_PASSWORD=
CATO_SMTP_FROM=

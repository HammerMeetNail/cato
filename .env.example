# Docker Compose reads this file only after copying it to .env.
# Private LAN HTTP: secure cookies must be false.
CATO_BASE_URL=http://10.0.0.42:7080
CATO_SECURE_COOKIES=false
# HTTPS reverse proxy: set the external https:// origin and secure cookies true.
# Register <CATO_BASE_URL>/api/auth/google/callback in Google OAuth settings.
GOOGLE_KEY=
GOOGLE_SECRET=
TWITCH_OAUTH_ID=
TWITCH_OAUTH_SECRET=
